{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard.cjs",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(supabase db push*)",
      "Bash(supabase migration up*)",
      "Bash(supabase link*)",
      "Read(./scripts/staff-passwords.local.json)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)"
    ]
  }
}
